// Back Channel — Broker DB schema
//
// See docs/production-architecture.md for the data-model rationale.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String   @id @default(uuid())
  handle          String   @unique
  email           String   @unique
  displayName     String?
  agentPubkey     String?
  agentEndpoint   String?
  apiKey         String?   @unique        // SEC H1: never read or written; nulled in prod 2026-09-24 (migration 20260924150000); drop later
  apiKeyLastUsedAt DateTime?              // dashboard "last used"; touched (throttled) by getAccountFromAuth
  createdAt       DateTime @default(now())
  emailVerifiedAt DateTime?
  notifyIdleFrames Boolean @default(true) // email me when a frame arrives while I'm idle
  favorPerPeerDaily    Int @default(5)     // max favors I'll accept from one peer per day
  favorGlobalTokensDaily Int @default(50000) // max borrowed-compute tokens/day across all peers
  liveModeDefaultMinutes Int @default(15)  // default live-mode window when a thread opts into real-time (inbox-model pivot)
  inboxCheckEnabled Boolean @default(true) // agent's bc-inbox-check should run (it reads this each cycle; false → self-remove)
  inboxCheckMinutes Int @default(10)       // cadence (minutes) the agent's bc-inbox-check should use
  admin            Boolean @default(false) // operator: can read metadata-only analytics (never content)
  reserved         Boolean @default(false) // pre-launch handle hold: occupies the @unique handle (signup 409s) but isn't a real account; transfer = clear this + set the real email
  reservedBy       String?                 // account id that holds the reservation (Skylar) — ownership/transfer marker
  welcomeSeededAt  DateTime?               // onboarding epic WS-A: set the FIRST time this account's agent connects (first AgentToken minted), seeds one self-inbox welcome AgentPayload; idempotency latch so it never fires twice

  // --- user-side decryption / key mirror (docs/user-side-decryption.md v2.1) ---
  // All nullable; presence of mirrorPub is the ONLY new broker-visible signal (I3):
  // it means "this account enrolled browser access." Never holds KEK/priv/plaintext.
  mirrorPub        String?   // X25519 public key (base64); agents wrap session keys to this
  mirrorPubVersion Int       @default(0)   // bumped on rotation (B4); agents tag user_wrap with it
  prfSalt          String?   // 32B WebAuthn PRF salt (base64, public input)
  recoveryWrap     String?   // mirror_priv sealed under HKDF(RK); never returned except in recovery flow
  recoveryCodeHash String?   // Argon2id(mnemonic) — UI typo check only, NOT a security control (S3)
  mirrorRotatedAt  DateTime?
  mirrorKeyWraps   MirrorKeyWrap[]

  invitesAsHost    Invite[]  @relation("HostInvites")
  invitesAsVisitor Invite[]  @relation("VisitorInvites")
  viewTokens       ViewToken[]
  sessionCookies   SessionCookie[]
  accountAudits    AccountAudit[]
  trustGiven       TrustedPeer[] @relation("TrustOwner")
  trustReceived    TrustedPeer[] @relation("TrustPeer")
  inboxReceived    InboxRequest[] @relation("InboxRecipient")
  inboxSent        InboxRequest[] @relation("InboxRequester")
  userSkills       UserSkill[]
  skillSharesRecv  SkillShare[]   @relation("SkillShareWith")
  skillInvocations SkillInvocation[]
  skillImports     SkillImport[]
  favorsReceived   FavorLog[]     @relation("FavorRecipient")
  favorsRequested  FavorLog[]     @relation("FavorRequester")
  favorMutes       FavorMute[]    @relation("FavorMuter")
  agentPayloads    AgentPayload[]
  exchangeCodes    ExchangeCode[]
  agentTokens      AgentToken[]
  friendInvites    FriendInvite[]
  // Back Channel Remote (AppBridge) remote access: relation fields only, no Account columns.
  appBridgeDevices      AppBridgeDevice[]
  appBridgeDeviceCodes  AppBridgeDeviceCode[]
  appBridgeEntitlements AppBridgeEntitlement[]
  appBridgeConnections  AppBridgeConnectionEvent[]
  // Back Channel Remote paid tier (Stripe): relation fields only, no Account columns.
  billingCustomer       BillingCustomer?
  remoteSubscriptions   RemoteSubscription[]
  // Lists (task lists for people and their agents): relation fields only, no Account columns.
  taskListsOwned        TaskList[]       @relation("TaskListOwner")
  taskListMemberships   TaskListMember[]
}

// Invite-a-friend (Phase 3). An existing user invites someone by email; the
// invitee gets a magic link to a befriend page. When they sign up + accept, the
// broker auto-creates MUTUAL trust (both TrustedPeer rows) — the invite IS the
// trust grant. Token hashed at rest.
model FriendInvite {
  id               String   @id @default(uuid())
  inviterAccountId String
  inviteeEmail     String                  // lowercased
  tokenHash        String   @unique         // sha256(raw); raw only in the email link
  note             String?
  status           String   @default("pending") // pending | accepted
  createdAt        DateTime @default(now())
  expiresAt        DateTime                 // createdAt + 14d
  acceptedAt       DateTime?
  inviter          Account  @relation(fields: [inviterAccountId], references: [id], onDelete: Cascade)

  @@index([inviterAccountId])
  @@index([inviteeEmail])
}

// Per-agent API tokens (per-agent-tokens Phase 1). Each connected agent gets its
// OWN bc_ key tied to the same account, individually revocable (GitHub-PAT style).
// Only the hash is stored. The legacy single Account.apiKey is backfilled into a
// row named "Original" and stays as an auth fallback for one deploy.
enum RuntimeType {
  cowork
  codex
  claude_code
  chatgpt
  other
}

model AgentToken {
  id          String      @id @default(uuid())
  accountId   String
  keyHash     String      @unique           // sha256(bc_ key); raw never stored
  name        String                          // user label, e.g. "Loby on home PC"
  runtimeType RuntimeType @default(other)
  createdAt   DateTime    @default(now())
  lastUsedAt  DateTime?                        // touched (throttled) on each authed request
  revokedAt   DateTime?                        // set on revoke; auth requires revokedAt IS NULL
  scope       String      @default("full")     // "full" | "connector" (minted by OAuth: no dashboard sign-in, no dispatch) — src/lib/agent-scope.ts
  dispatchName String?
  dispatchEncryptionKey String?
  dispatchSigningKey String?
  dispatchSent DispatchTask[] @relation("DispatchSender")
  dispatchReceived DispatchTask[] @relation("DispatchTarget")
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([accountId, revokedAt])
}

// Opaque authenticated encrypted envelopes only. A lost execution lease is never requeued.
model DispatchTask {
  id String @id
  senderAgentId String
  targetAgentId String
  status String @default("queued")
  sealed String
  resultSealed String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leaseHash String?
  leaseExpiresAt DateTime?
  sender AgentToken @relation("DispatchSender", fields: [senderAgentId], references: [id], onDelete: Cascade)
  target AgentToken @relation("DispatchTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@index([senderAgentId, createdAt, id])
  @@index([targetAgentId, createdAt, id])
}

// Exchange-code flow (device-code pattern): keeps raw bc_ keys out of LLM chat
// transcripts. The dashboard mints a short-lived single-use code; the user
// pastes ONLY the code to their agent; the agent exchanges it (no auth header)
// for the account's real apiKey. Code is hashed at rest and dead within 60s.
model ExchangeCode {
  codeHash    String      @id            // sha256(raw); raw is never stored
  accountId   String
  purpose     String      @default("exchange")
  agentName   String?                    // names the AgentToken minted on redemption
  runtimeType RuntimeType  @default(other)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime                   // createdAt + 60s
  usedAt      DateTime?
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// Self-inbox "deliver this to my own agent" channel (inbox-model pivot §5). A
// generic envelope a user drops for their OWN agent to pick up on its next
// bc-inbox-check. Phase 1 kind="skill": a reference to a skill a trusted peer
// shared with the user (the broker already holds that share, so `ref` exposes
// nothing new and isn't sealed). kind="welcome" (onboarding epic WS-A): the
// broker-authored concierge message seeded on an account's first agent
// connect — plaintext is fine since the broker authored it itself (content-
// blindness is about USER content). The future clipper (v1.x) will use a
// sealed kind where the broker stores only an opaque blob. Always
// self-addressed, so it adds no inbound-spam surface.
model AgentPayload {
  id          String    @id @default(uuid())
  accountId   String                  // owner = recipient = the only addressee (self)
  kind        String                  // "skill" (Phase 1) | "welcome" (WS-A)
  ref         Json                    // {skillId, name, skillKind, ownerHandle} | {text} for kind="welcome"
  note        String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?               // set when the agent has pulled it
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, deliveredAt])
}

// Favors — delegate a task to a trusted peer's agent (runs on THEIR compute).
// The task + result are sealed agent frames (favor.request/favor.response,
// content-blind). The broker holds only METADATA: an audit/counter log (for the
// per-peer + global daily caps and the reciprocity view) and the mute list.
model FavorLog {
  id                 String   @id @default(uuid())
  recipientAccountId String                  // who did the favor (spent compute)
  requesterAccountId String                  // who asked
  status             String                  // accepted | declined | completed
  tokensUsed         Int      @default(0)
  at                 DateTime @default(now())
  recipient Account @relation("FavorRecipient", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  requester Account @relation("FavorRequester", fields: [requesterAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, at])
  @@index([requesterAccountId, recipientAccountId, at])
}

// Time-boxed "mute favors from this peer" without revoking full trust.
model FavorMute {
  accountId      String                       // the muter (recipient)
  mutedAccountId String                       // the peer being muted
  until          DateTime
  account Account @relation("FavorMuter", fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, mutedAccountId])
}

// Skill Sharing (shared capabilities). A user-owned capability the owner's agent
// can run. Tier 2-RPC: kind=rpc — runs ONLY on the owner's side during a session
// (the broker stores it, never executes it; body is opaque to the broker).
// kind=template (Tier 2-Template) is copied to a peer; templates must be signed.
enum SkillKind {
  rpc
  template
}

// Polymorphic "Artifact" (skill | scheduled_task | prompt) — kept the model name
// UserSkill (and table) so existing rows, relations, and 10 call sites stay live;
// the artifact platform is delivered by the additive columns below (spec §1).
model UserSkill {
  id          String    @id @default(uuid())
  accountId   String
  type        String    @default("skill")  // "skill" | "scheduled_task" | "prompt" (text, matches migration §1.2)
  name        String
  description String?
  kind        SkillKind @default(rpc)
  body        String                  // type-specific payload (skill SKILL.md / cron+prompt / prompt text)
  paramSchema Json?
  signature   String?                 // ed25519 sig over canonical content (templates + new types)
  discoverable Boolean  @default(true)  // Tier 2.5: NAME+description visible to my trusted peers (discovery != access). On by default so a fresh user's circle has real skills (PMF item 8); toggle off per-skill.
  version     Int       @default(1)
  revision    String?                 // optional YYYY-MM-DD-N (v0.1)
  manifest    Json?                   // type-specific structured fields (spec §1.3); broker may inspect, never executes
  publicToken String?   @unique       // set when public stranger-share is enabled (spec §3)
  publicExpiresAt DateTime?           // TTL for public share
  publicRevokedAt DateTime?           // revocation latch
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shares      SkillShare[]

  @@index([accountId])
  @@index([type, accountId])
  @@index([publicToken])
}

model SkillShare {
  skillId             String
  sharedWithAccountId String
  sharedBy            String          // owner accountId (audit)
  sharedAt            DateTime @default(now())
  skill        UserSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sharedWith   Account   @relation("SkillShareWith", fields: [sharedWithAccountId], references: [id], onDelete: Cascade)

  @@id([skillId, sharedWithAccountId])
  @@index([sharedWithAccountId])
}

model SkillInvocation {
  id                 String   @id @default(uuid())
  skillId            String
  invokedByAccountId String
  sessionId          String
  result             String?         // status/metadata only — never the underlying data
  at                 DateTime @default(now())
  invokedBy Account @relation(fields: [invokedByAccountId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([sessionId])
}

// Tier 2-Template: an audit record that an account imported a (signed) template.
// The actual copy lives on the importer's LOCAL agent — this is provenance +
// the basis for an "uninstall" (reversible imports, skill-sharing-epic §8.2).
model SkillImport {
  id                  String   @id @default(uuid())
  skillId             String                  // source skill (author's)
  importedByAccountId String
  importedAt          DateTime @default(now())
  importedBy Account @relation(fields: [importedByAccountId], references: [id], onDelete: Cascade)

  @@unique([skillId, importedByAccountId])
  @@index([importedByAccountId])
}

// Inbox (Account Dashboard Wave 3). A mutually-trusted peer's agent drops a
// session request here; the recipient approves/declines from the dashboard.
// Trust waived the invite CODE, not the per-session scope approval — accepting
// mints a normal Invite+Session (requester=visitor, recipient=host).
enum InboxStatus {
  pending
  accepted
  rejected
  expired
}

model InboxRequest {
  id                 String      @id @default(uuid())
  recipientAccountId String
  requesterAccountId String
  requestedScopes    String[]
  message            String?
  status             InboxStatus @default(pending)
  sessionId          String?     // set when accepted (the minted session)
  createdAt          DateTime    @default(now())
  expiresAt          DateTime    // createdAt + 24h
  resolvedAt         DateTime?
  recipient Account @relation("InboxRecipient", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  requester Account @relation("InboxRequester", fields: [requesterAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, status])
  @@index([expiresAt])
}

// Trust (Account Dashboard Wave 2). DIRECTED: one row = "this account trusts
// that peer." Mutual trust (required to actually collaborate code-free) = both
// directed rows present. Per the resolved spec it's a dashboard enable/disable
// toggle: eligibility = the pair has had a real session before; enabling
// creates this row, revoking deletes it. accountId-keyed (survives handle
// changes; never transfers on handle reissue).
model TrustedPeer {
  id               String   @id @default(uuid())
  accountId        String   // the owner of this trust record
  trustedAccountId String   // the peer they trust
  establishedAt    DateTime @default(now())
  lastUsedAt       DateTime?
  scopeDefaults    String[] // ceiling for what this peer may request via inbox (Wave 3)
  account        Account @relation("TrustOwner", fields: [accountId],        references: [id], onDelete: Cascade)
  trustedAccount Account @relation("TrustPeer",  fields: [trustedAccountId], references: [id], onDelete: Cascade)

  @@unique([accountId, trustedAccountId])  // one directed row per pair
  @@index([accountId])
  @@index([trustedAccountId])
}

// Account Dashboard — short-lived, single-use token emailed to a verified
// account; exchanged at /api/auth/view-verify for a browser session cookie.
// Lets a human reach /account from email without pasting their bearer key.
model ViewToken {
  token     String   @id            // random urlsafe ("vt_...")
  accountId String
  purpose   String   @default("account") // "account" | "session:<id>" deep-link hint
  createdAt DateTime @default(now())
  expiresAt DateTime                 // createdAt + 15 min
  usedAt    DateTime?
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// Server-side browser session backing the httpOnly `bc_session` cookie. Grants
// the human dashboard tier (view/manage), a strict subset of the agent bearer
// key (cannot create invites / claim / poll / send).
model SessionCookie {
  token      String   @id            // random urlsafe ("cs_..."); value of bc_session cookie
  accountId  String
  createdAt  DateTime @default(now())
  expiresAt  DateTime                 // createdAt + 24h
  lastUsedAt DateTime?
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// Account-scoped audit (distinct from session-scoped AuditLog, which is FK-bound
// to a collaboration Session). Holds dashboard/account events: view-token.issued,
// view-token.consumed, key.rotated, trust.revoked, session.ended_manually, etc.
model AccountAudit {
  id        BigInt   @id @default(autoincrement())
  accountId String
  ts        DateTime @default(now())
  eventType String
  detail    Json     // metadata only — never plaintext content
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([ts])
}

model Invite {
  id                 String   @id @default(uuid())
  code               String   @unique
  hostAccountId      String
  visitorAccountId   String
  scopes             String[]
  ttlMinutes         Int
  message            String?
  status             InviteStatus @default(pending)
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  claimedAt          DateTime?
  confirmedAt        DateTime?

  host    Account @relation("HostInvites",    fields: [hostAccountId],    references: [id])
  visitor Account @relation("VisitorInvites", fields: [visitorAccountId], references: [id])
  session Session?

  @@index([hostAccountId])
  @@index([visitorAccountId])
  @@index([code])
}

enum InviteStatus {
  pending
  claimed
  confirmed
  expired
  kicked
}

model Session {
  id             String   @id @default(uuid())
  inviteId       String   @unique
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  endReason      String?
  scopesGranted  String[]
  liveExpiresAt  DateTime?              // inbox-model pivot: when set + future, this thread is in opt-in real-time (live) mode; agents poll fast until it lapses, then revert to async inbox cadence
  // Key mirror (v2.1 §6): map { [accountId]: { v, enc, decoy? } } — session content key K
  // sealed (HPKE) to each participant's mirrorPub. ALWAYS populated (real or decoy)
  // when a participant has mirrorPub, so presence never leaks per-session state (S1).
  userWrap       Json?

  invite     Invite     @relation(fields: [inviteId], references: [id])
  auditLog   AuditLog[]
}

// One row per unlock method/device (v2.1 §4.4/§6). The KEK never leaves the browser;
// we only store mirror_priv sealed under it. Multiple wraps = multi-device / passphrase
// backup without invalidating the others (S8).
model MirrorKeyWrap {
  id                String   @id @default(uuid())
  accountId         String
  method            String   // "prf" | "passphrase"
  label             String?  // "MacBook (Touch ID)", "passphrase", …
  credentialId      String?  // WebAuthn credential id (public) for prf
  kdfParams         Json?    // passphrase: { algo:"argon2id", m, t, p, salt } (NO kek_check — B2)
  wrappedMirrorPriv String   // AEAD(KEK, mirror_priv, aad="mirror-priv-v1|accountId")
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  sessionId String
  ts        DateTime @default(now())
  role      String   // "visitor" | "host"
  eventType String
  detail    Json     // redacted — no plaintext content

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([ts])
}

// Lightweight day-bucketed operator counters (e.g. rate-limit hits). Incremented
// fire-and-forget; read by the admin dashboard. Never holds content/PII.
model DailyMetric {
  day   String  // "YYYY-MM-DD" (UTC)
  key   String  // e.g. "rate_limit_hits"
  count Int     @default(0)

  @@id([day, key])
  @@index([key])
}

model MagicLink {
  token       String   @id
  email       String
  expiresAt   DateTime
  consumedAt  DateTime?
  claimCode   String?  // M1: if set, auto-claim this invite for the account right after verify

  @@index([email])
  @@index([expiresAt])
}

// Relay frame buffer, persisted so an in-flight session survives a broker
// restart/redeploy (the in-memory globalThis buffer is rebuilt from here on the
// first poll/connect after restart). Capped per (session, roleDest) at the same
// 512-frame limit as memory; trimmed on eviction; purged when the session ends.
// Bodies are the relayed frames (ideally end-to-end ciphertext) — transient,
// not a long-term store.
model Frame {
  id        BigInt   @id @default(autoincrement())
  sessionId String
  roleDest  String   // "visitor" | "host" — the role this frame is addressed TO
  seq       Int      // per-(session, roleDest) sequence number
  body      String
  createdAt DateTime @default(now())

  @@unique([sessionId, roleDest, seq])
  @@index([sessionId, roleDest, seq])
}

// ── Back Channel Remote (AppBridge) remote access ───────────────────────────
// docs/appbridge-remote-access.md. Everything here is additive and separate
// from agent credentials: an AppBridge device authenticates with its own ab_
// credential, and no bc_ key or dashboard cookie can obtain a relay pass.
// Nothing here stores an IP, a user agent or session content.

// A PC (host) or phone/PC client (remote) registered to an account. The
// connector key is the device's own P-256 key; its private half never leaves it.
model AppBridgeDevice {
  id                  String                @id // 22-char base64url
  accountId           String
  role                String // "host" | "remote"
  label               String? // owner-chosen name, shown on the dashboard only
  connectorSpki       String // base64 DER SubjectPublicKeyInfo (P-256)
  connectorSpkiSha256 String // uppercase hex SHA-256 of the DER
  enabled             Boolean               @default(true)
  relayEnabled        Boolean               @default(false) // hosts: the owner's "allow internet access" switch
  createdAt           DateTime              @default(now())
  revokedAt           DateTime?
  account             Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  credentials         AppBridgeCredential[]
  hostPairings        AppBridgePairing[]    @relation("AppBridgePairingHost")
  remotePairings      AppBridgePairing[]    @relation("AppBridgePairingRemote")

  @@index([accountId])
  @@index([connectorSpkiSha256])
}

// A device's bearer credential (ab_ prefix). Only its SHA-256 is stored.
model AppBridgeCredential {
  keyHash   String          @id
  deviceId  String
  accountId String
  scopes    String[]
  createdAt DateTime        @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  // Rotation grace: the keyHash of the credential this one replaced. That credential stays valid until
  // this one is first used (then it is revoked and this is cleared) or for 24 h at most.
  replacesKeyHash String?
  device    AppBridgeDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// One-use code the signed-in dashboard mints so a device can register itself.
model AppBridgeDeviceCode {
  codeHash  String    @id // sha256(raw); raw is never stored
  accountId String
  role      String // the role the device must register as
  label     String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// A host's attestation that its owner approved this remote on the LAN.
model AppBridgePairing {
  hostDeviceId   String
  enrollmentId   String
  remoteDeviceId String
  attestedAt     DateTime        @default(now())
  withdrawnAt    DateTime?
  host           AppBridgeDevice @relation("AppBridgePairingHost", fields: [hostDeviceId], references: [id], onDelete: Cascade)
  remote         AppBridgeDevice @relation("AppBridgePairingRemote", fields: [remoteDeviceId], references: [id], onDelete: Cascade)

  @@id([hostDeviceId, enrollmentId])
  @@index([remoteDeviceId])
}

// feature = "appbridge.remote_access". Set by an admin (the owner's accounts and comps).
// A paid Remote subscription (RemoteSubscription) entitles independently; the relay gate
// reads both, fresh, in its own transaction (src/lib/remote-entitlement.ts).
model AppBridgeEntitlement {
  accountId String
  feature   String
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, feature])
}

// A one-use relay pass (about 60 s). Only its hash is stored; swept minutes after expiry.
model AppBridgePass {
  passHash       String    @id
  purpose        String // "session" | "presence" | "agent" | "support"
  accountId      String
  hostDeviceId   String // "support": the helper's ephemeral relay identity, not a device
  remoteDeviceId String?
  enrollmentId   String?
  // "agent" and "support" passes only: the RemoteAppSession it is for (no FK, see RemoteAppSession).
  remoteAppSessionId String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  @@index([expiresAt])
}

// A live relay pair's lease, renewed by the relay every ~60 s for 120 s at a time.
model AppBridgeLease {
  id             String   @id
  purpose        String
  accountId      String
  hostDeviceId   String
  remoteDeviceId String?
  enrollmentId   String?
  // "agent" and "support" leases only: the RemoteAppSession it belongs to. Ending the session deletes these.
  remoteAppSessionId String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([remoteAppSessionId])
}

// "Device A connected to PC B at time T" — the owner's 7-day connection log.
// No IP, no duration, no byte count. Rows older than 7 days are deleted.
model AppBridgeConnectionEvent {
  id             String   @id @default(uuid())
  accountId      String
  hostDeviceId   String
  remoteDeviceId String
  at             DateTime @default(now())
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, at])
  @@index([at])
}

// ── Remote app sessions: an agent uses an app on one of its person's own PCs ─
// docs/remote-app-sessions.md. One agent, one named PC, an app allow-list, a
// time limit (at most 60 minutes) and usually one Lists task. A session becomes
// active only when its person approves it in the dashboard. While it is active
// (and only then) the PC may hold an "agent" relay lease for it; stopping it
// deletes those leases in the same transaction. Metadata only: never what was
// on the screen, what was typed or a screenshot (evidence stays on the PC).
// hostDeviceId, agentTokenId, executorAgentId and listTaskId carry no foreign
// key on purpose: removing a PC or an agent ends a session, and must never
// delete the record of what happened. No back-relations on Account/AgentToken.
model RemoteAppSession {
  id              String    @id @default(uuid())
  accountId       String
  kind            String    @default("agent") // "agent" (Phase A) | "support" (Phase B, docs/remote-support.md)
  // "agent": the PC, an AppBridgeDevice with role "host". "support": NOT a device. The helper's ephemeral
  // relay identity ("support_" + 22 characters), minted at redemption; no AppBridgeDevice ever has it.
  hostDeviceId    String
  agentTokenId    String // the agent that asked for the session (for "support": the one that asked for the code)
  executorAgentId String? // the agent on the PC that drives the app; null = the agent that asked
  listTaskId      String? // the Lists task this session works on
  goal            String // "support": the exact task text the helped person was shown
  appAllowList    String[] // app names as the person approved them; the PC enforces the list ("support": empty)
  status          String    @default("awaiting_consent") // awaiting_consent | active | blocked | ended | denied | lapsed
  consentBy       String? // the account that approved or denied it ("support": null; the helped person has no account)
  consentVia      String? // "web": the dashboard (Phase A); "helper": Allow on the helped person's own screen (support)
  minutes         Int // 1..60 ("support": 1..45)
  startedAt       DateTime?
  expiresAt       DateTime? // startedAt + minutes; never extended
  endedAt         DateTime?
  endReason       String? // done | user_stop | host_stop | agent_stop | lapsed | fail_closed | revoked | reported
  summary         String? // the agent's own words when it ended the session
  evidenceRef     String? // a pointer into the PC's own evidence store, never the evidence
  createdAt       DateTime  @default(now())
  // ── "support" sessions only (docs/remote-support.md); null for "agent" ──
  helperLabel                String? // who it's for, in the issuer's agent's words; shown to the issuer only
  supportKeySha256           String? // the temporary client's P-256 key, pinned at redemption (uppercase hex SHA-256 of its DER)
  supportKeySpki             String? // that key (base64 DER SubjectPublicKeyInfo), to check its signed Allow and removal receipt
  supportCredentialHash      String?   @unique // sha256 of the client's abs_ credential; the raw value is never stored
  supportCredentialExpiresAt DateTime? // fixed at redemption, never renewed
  removal                    String? // removed | in_memory | unconfirmed: the client's signed removal receipt
  removalAt                  DateTime?

  @@index([accountId, status])
  @@index([agentTokenId])
  @@index([hostDeviceId, status])
  @@index([supportKeySha256])
}

// One step of a remote app session, as fixed metadata: a kind of action, a
// bounded control or app name, and an outcome. Never a value, text or pixels.
model RemoteAppActionLog {
  id          BigInt   @id @default(autoincrement())
  sessionId   String // RemoteAppSession.id (no FK: see above)
  at          DateTime @default(now())
  action      String // open | observe | invoke | set_value | toggle | select | scroll | key | screenshot | blocked
  target      String? // a control or app name, at most 120 characters
  outcome     String // ok | credential_field | not_in_scope | needs_user | fail_closed | declined ("support": the helped person said no on their screen)
  evidenceRef String? // a pointer into the PC's own evidence store

  @@index([sessionId, at])
}

// ── Remote support: one-time help for someone else (docs/remote-support.md) ──
// Phase B. An agent asks for a support code; its person (owner-only in v1)
// approves it in the dashboard, which mints a single-use code BCS-XXXX-XXXX
// (only its hash is stored) shown to the person alone. They send it themselves.
// The helped person's temporary client redeems it with a fresh key, which
// creates a RemoteAppSession with kind "support" pinned to that key; nothing
// can act until they press Allow on their own screen. No foreign keys, like
// RemoteAppSession: ending or deleting things must never erase what happened.
model SupportInvite {
  id            String    @id @default(uuid())
  accountId     String // the issuer: the person whose account mints the code
  agentTokenId  String // the agent that asked for it
  forName       String // who it's for, in the agent's words ("Mom"); shown to the issuer only
  task          String // the exact task text the helped person sees
  minutes       Int // 1..45: the session's cap once they allow it
  listTaskId    String? // the Lists task it's bound to (claimed by the agent that asked)
  status        String    @default("requested") // requested | denied | lapsed | withdrawn | minted | voided | expired | reported | redeemed
  codeHash      String?   @unique // sha256 of the code; set when minted. The code itself is never stored
  mintedAt      DateTime?
  codeExpiresAt DateTime? // mintedAt + 15 minutes: the redeem window
  redeemedAt    DateTime?
  sessionId     String?   @unique // the RemoteAppSession the redemption created
  closedAt      DateTime? // when it stopped being usable without being redeemed
  createdAt     DateTime  @default(now())

  @@index([accountId, status])
  @@index([accountId, mintedAt])
  @@index([agentTokenId])
}

// "I didn't ask for this": filed from the landing page (via "page", which also
// cancels the code) or from the temporary client (via "helper", which also ends
// the session). The issuer sees these on the Remote page.
model SupportReport {
  id        String   @id @default(uuid())
  accountId String // the issuer the report is about
  inviteId  String
  sessionId String?
  via       String // page | helper
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([inviteId])
}

// ── Back Channel Remote paid tier (Stripe) ──────────────────────────────────
// docs/remote-paid-tier.md. Additive only. No card data, email or address is
// stored here: Stripe holds those. These rows only say which Stripe customer is
// which account, and what state that customer's Remote subscription is in.

// One Stripe customer per account, created by the broker before the first
// Checkout. A webhook maps a subscription to an account ONLY through this row.
model BillingCustomer {
  accountId        String   @id
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// The latest state of a Remote subscription, mirrored from signed Stripe events.
// Entitlement is derived from this row at read time (src/lib/remote-entitlement.ts),
// never copied into AppBridgeEntitlement.
model RemoteSubscription {
  stripeSubscriptionId String    @id
  accountId            String
  status               String // Stripe's status: active | trialing | past_due | canceled | unpaid | incomplete | incomplete_expired | paused
  priceId              String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  pastDueSince         DateTime? // start of the past_due grace clock; null unless past_due
  lastEventAt          DateTime // Stripe event.created of the snapshot applied; older snapshots are ignored
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Stripe event ids already processed (idempotency). Pruned after 30 days;
// Stripe stops retrying an event after 3.
model StripeEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ── Lists: task lists for people and their agents (docs/lists.md) ──────────
// List content is stored readable by the broker ON PURPOSE (decision
// 2026-10-09): lists must work from every host, and remote MCP connectors
// (claude.ai, ChatGPT) cannot decrypt anything. /privacy says so. Messages
// between agents stay end-to-end encrypted; nothing here touches them.
// Agents are never members. TaskListAgentGrant lets a person's OWN agent see or
// work a list, and every agent action records both the agent and its person.
// Attribution ids (createdBy*, claim*, completedBy*, author*) are plain columns
// with no foreign key: revoking an agent or a person leaving must never
// cascade-delete the history of what they did.
model TaskList {
  id             String    @id @default(uuid())
  ownerAccountId String
  name           String
  emoji          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          Account   @relation("TaskListOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  members        TaskListMember[]
  agentGrants    TaskListAgentGrant[]
  tasks          TaskItem[]
  events         TaskListEvent[]

  @@index([ownerAccountId])
}

model TaskListMember {
  listId           String
  accountId        String
  role             String   // owner | member
  agentsTakeFrom   String   @default("me") // me | anyone: whose tasks this person's agents may act on without an OK
  notify           String   @default("off") // off | mentions_reviews: opt-in email nudges for this person on this list
  addedByAccountId String
  joinedAt         DateTime @default(now())
  list             TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([listId, accountId])
  @@index([accountId])
}

model TaskListAgentGrant {
  listId       String
  agentTokenId String   // AgentToken.id of one of accountId's agents (no FK: see the block comment)
  accountId    String   // the agent's person, who granted it; must be a member of the list
  access       String   // view | work
  createdAt    DateTime @default(now())
  list         TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, agentTokenId])
  @@index([agentTokenId])
}

model TaskItem {
  id                   String    @id @default(uuid())
  listId               String
  title                String
  notes                String    @default("")
  version              Int       @default(1)       // optimistic concurrency on title/notes edits
  status               String    @default("open")  // open | in_progress | blocked | needs_review | done | dropped
  position             Float
  dueAt                DateTime?
  createdByAccountId   String
  createdByAgentId     String?
  assigneeAccountId    String?
  assigneeAgents       Boolean   @default(false)   // "that person's agents" rather than the person
  assigneeAgentId      String?                     // one specific agent
  agentSeenAt          DateTime?                   // first time one of the assignee's agents saw it; the doorbell counts it until then
  claimAccountId       String?
  claimAgentId         String?
  claimedAt            DateTime?
  claimExpiresAt       DateTime?                   // agents only: lapses after 60 quiet minutes
  reviewerAccountId    String?
  completedAt          DateTime?
  completedByAccountId String?
  completedByAgentId   String?
  summary              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  list                 TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  entries              TaskEntry[]
  oks                  TaskAgentOk[]
  mentions             TaskMention[]
  reactions            TaskReaction[]

  @@index([listId, status, position])
  @@index([assigneeAccountId, status])
  @@index([claimAgentId])
  @@index([updatedAt])
}

model TaskEntry {
  id              String   @id @default(uuid())
  taskId          String
  kind            String   // comment | progress | event
  authorAccountId String
  authorAgentId   String?
  body            String
  eventType       String?
  createdAt       DateTime @default(now())
  task            TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions        TaskMention[]

  @@index([taskId, createdAt])
}

// ── Lists Phase 2: sharing with friends (docs/lists.md) ─────────────────────
// A member counts only while they and the owner are mutual friends (both
// TrustedPeer rows); lists.ts checks that on every request, so access fails
// closed. These tables follow the same no-FK attribution rule as above.

// "My agents may act on this task": one row per person who OK'd it. An OK only
// ever covers the OK-giver's own agents.
model TaskAgentOk {
  taskId     String
  accountId  String   // the person whose agents may now act on it
  via        String   // web | user_in_chat | list_setting
  viaAgentId String?  // the agent that recorded an OK its person gave in chat
  createdAt  DateTime @default(now())
  task       TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, accountId])
  @@index([accountId])
}

// An @mention in a comment or progress line: a person on the list, or one of a
// member's agents with access to it. Agent mentions ring that person's doorbell
// until the agent sees them; person mentions wait on their plate.
model TaskMention {
  id        String    @id @default(uuid())
  entryId   String
  taskId    String
  accountId String    // the person mentioned, or the person whose agent was
  agentId   String?   // set when an agent was mentioned
  seenAt    DateTime?
  createdAt DateTime  @default(now())
  entry     TaskEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  task      TaskItem  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([accountId, seenAt])
  @@index([taskId])
  @@index([entryId])
}

// 👍 🎉 🙏 ✅ on a task, by a person or one of their agents. The migration adds a
// unique index on (taskId, accountId, COALESCE(agentId, ''), emoji), which
// Prisma can't express, so a reaction toggles rather than stacks.
model TaskReaction {
  id        String   @id @default(uuid())
  taskId    String
  accountId String
  agentId   String?
  emoji     String
  createdAt DateTime @default(now())
  task      TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// List-level activity: someone added, someone left or was taken off.
model TaskListEvent {
  id               String   @id @default(uuid())
  listId           String
  eventType        String   // member_added | member_left | member_removed
  actorAccountId   String
  subjectAccountId String
  createdAt        DateTime @default(now())
  list             TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, createdAt])
}

// ── Lists Phase 3: templates and the daily digest (docs/lists.md) ───────────
// Both tables belong to one person. Neither declares a Prisma relation, so
// Account stays untouched; the migration (20261009230000_task_lists_phase3)
// adds the foreign keys to "Account" with ON DELETE CASCADE, so deleting an
// account deletes its templates and its preference.

// A list someone saved to start new lists from. Seen only by its owner and the
// owner's agents. items: [{ title, notes }], 1 to 200: the unfinished tasks the
// owner (or one of their agents) wrote when they saved it.
model TaskListTemplate {
  id             String   @id @default(uuid())
  ownerAccountId String
  name           String
  emoji          String?
  items          Json
  createdAt      DateTime @default(now())

  @@index([ownerAccountId])
}

// One person's Lists settings that aren't about any one list: the opt-in daily
// digest email, sent at digestHour in their timezone, at most once a local day.
model ListsPreference {
  accountId    String    @id
  digest       String    @default("off") // off | daily
  digestHour   Int       @default(8)     // 0 to 23, the person's local hour
  timezone     String?                   // IANA name, e.g. America/Denver; UTC when null
  lastDigestAt DateTime?                 // when the last digest was claimed for sending

  @@index([digest])
}
